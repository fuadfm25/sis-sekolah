#--------------------------------------------------------------------
# CONTOH KONFIGURASI – salin menjadi file bernama .env lalu sesuaikan
#--------------------------------------------------------------------

# development = tampilkan error detail; production = untuk dipakai sekolah
CI_ENVIRONMENT = development

# Alamat aplikasi (akhiri dengan /). Untuk kiosk di perangkat lain, pakai IP server, bukan localhost.
#   php spark serve            -> http://localhost:8080/
#   XAMPP folder htdocs        -> http://localhost/sis-sekolah/public/
#   diakses dari jaringan LAN  -> http://192.168.1.10/sis-sekolah/public/
# Kosongkan (beri tanda #) agar alamat terdeteksi otomatis, atau isi sesuai alamat di browser:
# app.baseURL = 'http://localhost/sis-sekolah/public/'

# Kosongkan bila ingin URL tanpa "index.php" (butuh mod_rewrite Apache aktif)
# app.indexPage = ''

# Database aplikasi
database.default.hostname = localhost
database.default.database = db_sis_sekolah
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port     = 3306

# Database LAMA – hanya untuk: php spark db:seed ImporDataLamaSeeder
# database.lama.hostname = localhost
# database.lama.database = db_sis_sekolah_lama
# database.lama.username = root
# database.lama.password =
